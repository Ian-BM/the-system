# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://the_system_user:the_system_password@localhost:5432/the_system_db

# Local timezone — the app syncs quest days and the 12:01 AM accountability
# check to this timezone. Use a tz database name, e.g. America/New_York.
TIME_ZONE=UTC

# Date the workout schedule switches from home workouts to gym Push/Pull/Legs
GYM_CUTOVER_DATE=2026-09-28
